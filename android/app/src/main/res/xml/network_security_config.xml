<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so the app can reach an `opencode serve` running on your own PC/LAN
     (e.g. http://192.168.1.20:4096). All of the app's own traffic (OpenCode Go, search, CDNs) uses https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
