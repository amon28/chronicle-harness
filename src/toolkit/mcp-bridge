#!/usr/bin/env python3
# mcp-bridge: runs a stdio MCP server and serves it as Streamable HTTP on 127.0.0.1, so the app's MCP client
# can use it. Usage: mcp-bridge --port 39123 --secret S [--cwd DIR] -- <command and args>
# Each request needs "Authorization: Bearer S" (other apps on the phone can reach 127.0.0.1 too).
# POST /mcp with one JSON-RPC message: a request waits for the server's answer (JSON), a notification gets 202.
# GET /health answers 200 while the server is running. Server stderr goes to this process's stderr.
import json, subprocess, sys, threading, os, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

args = sys.argv[1:]
opts = {"--port": "39123", "--secret": "", "--cwd": None}
while args and args[0] != "--":
    k = args.pop(0)
    opts[k] = args.pop(0) if args else ""
if args and args[0] == "--":
    args.pop(0)
if not args or not opts["--secret"]:
    sys.exit("usage: mcp-bridge --port N --secret S [--cwd DIR] -- command [args...]")

cmd = args if len(args) > 1 else ["/bin/sh", "-c", args[0]]
child = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, cwd=opts["--cwd"] or None, bufsize=0)
lock = threading.Lock()
waiting = {}  # id -> [event, response]

def reader():
    buf = b""
    while True:
        chunk = child.stdout.readline()
        if not chunk:
            break
        line = chunk.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except Exception:
            sys.stderr.write("mcp-bridge: not JSON from server: %r\n" % line[:200])
            continue
        for m in msg if isinstance(msg, list) else [msg]:
            mid = m.get("id") if isinstance(m, dict) else None
            if mid is not None and ("result" in m or "error" in m):
                w = waiting.get(json.dumps(mid))
                if w:
                    w[1] = m
                    w[0].set()
            elif isinstance(m, dict) and m.get("method") and mid is not None:
                # a request from the server (sampling, roots…): not supported – answer so it does not hang
                send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "not supported by this client"}})
    for w in list(waiting.values()):
        w[0].set()

def send(obj):
    data = (json.dumps(obj) + "\n").encode()
    with lock:
        child.stdin.write(data)
        child.stdin.flush()

threading.Thread(target=reader, daemon=True).start()

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def reply(self, code, body=b"", ctype="application/json"):
        self.send_response(code)
        self.send_header("Access-Control-Allow-Origin", "*")  # the app's web view; the secret is what guards it
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def authed(self):
        if self.headers.get("Authorization", "") != "Bearer " + opts["--secret"]:
            self.reply(401, b'{"error":"bad secret"}')
            return False
        return True

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.end_headers()

    def do_GET(self):
        if not self.authed():
            return
        if self.path.startswith("/health"):
            return self.reply(200 if child.poll() is None else 503, json.dumps({"running": child.poll() is None, "pid": child.pid}).encode())
        self.reply(405)

    def do_DELETE(self):
        if self.authed():
            self.reply(200)

    def do_POST(self):
        if not self.authed():
            return
        if child.poll() is not None:
            return self.reply(503, json.dumps({"error": "the server exited (code %s)" % child.returncode}).encode())
        n = int(self.headers.get("Content-Length") or 0)
        try:
            msg = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self.reply(400, b'{"error":"not JSON"}')
        mid = msg.get("id") if isinstance(msg, dict) else None
        if mid is None:
            send(msg)
            return self.reply(202)
        key = json.dumps(mid)
        w = waiting[key] = [threading.Event(), None]
        send(msg)
        w[0].wait(float(os.environ.get("MCP_BRIDGE_TIMEOUT", "120")))
        waiting.pop(key, None)
        if w[1] is None:
            return self.reply(504, json.dumps({"jsonrpc": "2.0", "id": mid, "error": {"code": -32000, "message": "no answer from the server"}}).encode())
        self.reply(200, json.dumps(w[1]).encode())

srv = ThreadingHTTPServer(("127.0.0.1", int(opts["--port"])), H)
threading.Thread(target=lambda: (child.wait(), time.sleep(1), srv.shutdown()), daemon=True).start()
sys.stderr.write("mcp-bridge: serving pid %d on 127.0.0.1:%s\n" % (child.pid, opts["--port"]))
srv.serve_forever()
