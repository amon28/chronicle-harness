#!/bin/sh
# toolkit-pull — one home for the helper scripts; everything else in PATH is a cache.
# Idempotent: run it after a re-image or a restart.
#   toolkit-pull                                            -> pull from /workspace/.toolkit-url, then verify
#   TOOLKIT_URL=https://example.com/toolkit toolkit-pull   -> pull from that one source instead
# Sources: TOOLKIT_URL, else every line of /workspace/.toolkit-url (# comments and blanks ignored).
# The app adds a line there for each skill whose scripts/ folder it placed in the workspace
# (file:///workspace/skills/<name>/scripts), so a skill's tools reach PATH with one command.
# A source may carry its own manifest (<source>/.toolkit, "sha256  name" lines): then its scripts are
# pulled and checked against it. Without one, the app's own helpers are pulled and checked against
# the manifest the app installed. A script only replaces the old copy when its checksum matches, so a
# half-downloaded file can never take the place of a working one.
D=${TOOLKIT_DIR:-/usr/local/bin}
M="$D/.toolkit"        # the app's helpers (written by the app)
X="$D/.toolkit-extra"  # scripts pulled from other sources (written here)
URLS=${TOOLKIT_URLS_FILE:-/workspace/.toolkit-url}
T=${TMPDIR:-/tmp}
GOOD="$T/.toolkit-pull-good.$$"
BAD="$T/.toolkit-pull-bad.$$"
SRC="$T/.toolkit-pull-src.$$"
SGOOD="$T/.toolkit-pull-sgood.$$"
SBAD="$T/.toolkit-pull-sbad.$$"
cleanup() { rm -f "$GOOD" "$BAD" "$SRC" "$SGOOD" "$SBAD"; }

# A manifest line is an entry only when it is exactly two fields and the first is a sha256. Comments
# ("# generated by the app ...") and blank lines are not scripts; every other line is reported once
# and never pulled - a mangled manifest must not be able to invent a script.
#   parse <manifest> <good out> <bad out>
parse() {
  rm -f "$2" "$3"
  : > "$2"
  awk -v good="$2" -v bad="$3" '
    { sub(/\r$/, "") }
    /^[[:space:]]*#/ { next }
    NF == 0 { next }
    NF == 2 {
      n = $2
      sub(/^\*/, "", n)
      if (n != "" && n !~ /\// && length($1) == 64 && $1 !~ /[^0-9a-f]/) { print $1 "  " n > good; next }
    }
    { print NR " " $0 > bad }
  ' "$1" 2>/dev/null
}
# hash of name in a parsed manifest:  lookup <good file> <name>
lookup() {
  [ -f "$1" ] || return 1
  awk -v n="$2" '$2 == n { print $1; exit }' "$1" 2>/dev/null
}
now() {
  sha256sum "$D/$1" 2>/dev/null | cut -d' ' -f1
}
short() { echo "${1%????????????????????????}"; }

mkdir -p "$D" || { echo "toolkit-pull: cannot write $D" >&2; exit 1; }

fail=0
if [ -f "$M" ]; then
  parse "$M" "$GOOD" "$BAD"
  if [ -s "$BAD" ]; then
    while read -r n rest; do
      echo "toolkit-pull: bad manifest line $n: $rest" >&2
      fail=1
    done < "$BAD"
  fi
else
  : > "$GOOD"
fi

# the sources, one per line
if [ -n "${TOOLKIT_URL:-}" ]; then
  sources=$TOOLKIT_URL
elif [ -f "$URLS" ]; then
  sources=$(sed 's/\r$//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$URLS" 2>/dev/null | grep -v '^#' | grep -v '^$')
else
  sources=
fi

# record a pulled script in the extra manifest (one line per name, newest wins)
remember() {
  touch "$X" 2>/dev/null
  awk -v n="$2" '$2 != n' "$X" > "$X.new" 2>/dev/null && mv "$X.new" "$X"
  echo "$1  $2" >> "$X"
}

# fetch one URL into a file; prints nothing, sets rc/code
fetch() {
  code=$(curl -sfL --max-time 20 -w '%{http_code}' "$1" -o "$2" 2>/dev/null)
  rc=$?
}

pulled_any=0
if [ -n "$sources" ]; then
  if ! command -v curl >/dev/null 2>&1; then
    echo "toolkit-pull: no curl in this shell (apt-get install -y curl, or apk add curl)" >&2
    cleanup
    exit 1
  fi
  for B in $sources; do
    B=${B%/}
    pulled_any=1
    found=0; missing=0; unreach=0
    # does this source say what it carries?
    own=0
    fetch "$B/.toolkit" "$SRC"
    if [ "$rc" -eq 0 ] && [ -s "$SRC" ]; then
      parse "$SRC" "$SGOOD" "$SBAD"
      if [ -s "$SBAD" ]; then
        while read -r n rest; do
          echo "toolkit-pull: bad manifest line $n in $B/.toolkit: $rest" >&2
          fail=1
        done < "$SBAD"
      fi
      [ -s "$SGOOD" ] && own=1
    fi
    if [ "$own" -eq 1 ]; then
      names=$(awk '{ print $2 }' "$SGOOD")
    else
      names=$(awk '{ print $2 }' "$GOOD")
      [ -n "$names" ] || names="job doctor toolkit-pull mcp-bridge"
    fi
    for n in $names; do
      tmp="$D/.$n.new"
      rm -f "$tmp"
      # tell "the host answered: no such file" apart from "the host never answered"
      # (curl exit 22 = the server answered with an error; file:// has no HTTP code, so go by the exit)
      fetch "$B/$n" "$tmp"
      if [ "$rc" -eq 0 ]; then
        found=$((found + 1))
      elif [ "$rc" -eq 22 ] || [ "$rc" -eq 37 ]; then
        case "$code" in 000|"") why="not found there" ;; *) why="not found there: HTTP $code" ;; esac
        echo "pull  $n FAILED ($why)"; fail=1; missing=$((missing + 1)); rm -f "$tmp"; continue
      else
        echo "pull  $n FAILED (not reachable)"; fail=1; unreach=$((unreach + 1)); rm -f "$tmp"; continue
      fi
      # a copy that came through Windows (or an editor) may have CRLF endings; manifest hashes are of LF
      sed -i 's/\r$//' "$tmp" 2>/dev/null
      h=$(sha256sum "$tmp" 2>/dev/null | cut -d' ' -f1)
      # the app's own helpers are always checked against the app's manifest, whoever serves them
      core=$(lookup "$GOOD" "$n")
      if [ -n "$core" ]; then w=$core
      elif [ "$own" -eq 1 ]; then w=$(lookup "$SGOOD" "$n")
      else w=
      fi
      if [ -n "$w" ] && [ "$h" != "$w" ]; then
        echo "pull  $n SKIPPED (checksum mismatch: got $(short "$h") want $(short "$w"))"
        rm -f "$tmp"; fail=1; continue
      fi
      if mv "$tmp" "$D/$n" && chmod 755 "$D/$n"; then
        echo "pull  $n replaced (sha256 $(short "$h"))"
        [ -n "$core" ] || remember "$h" "$n"
      else
        echo "pull  $n FAILED (could not install into $D)"; fail=1; rm -f "$tmp"
      fi
    done
    if [ "$found" -eq 0 ] && [ "$missing" -gt 0 ]; then
      echo "toolkit-pull: $B answered but has none of these scripts - it does not look like a toolkit mirror (check the URL)" >&2
    elif [ "$found" -eq 0 ] && [ "$unreach" -gt 0 ]; then
      echo "toolkit-pull: could not reach $B at all (network, or a wrong host name)" >&2
    fi
    echo "toolkit-pull: source $B"
  done
  [ "$fail" -eq 0 ] || echo "toolkit-pull: finished with errors" >&2
else
  echo "toolkit-pull: no TOOLKIT_URL and no source in /workspace/.toolkit-url - verifying the copies the app installed"
  echo "              (a skill with a scripts/ folder adds itself there when it is used; or write_file .toolkit-url https://… )"
fi

# what is installed, and whether it is what the manifests say
printf '%-14s %-12s %s\n' script state sha256
row() { # name expected-hash
  if [ ! -f "$D/$1" ]; then
    printf '%-14s %-12s %s\n' "$1" missing -
    return
  fi
  h=$(now "$1")
  state=ok
  [ -x "$D/$1" ] || state=NOT-EXECUTABLE
  if [ "$state" = ok ] && [ -n "$2" ] && [ "$h" != "$2" ]; then state=DRIFT; fi
  printf '%-14s %-12s %s\n' "$1" "$state" "$(short "$h")"
}
for n in job doctor toolkit-pull mcp-bridge; do
  row "$n" "$(lookup "$GOOD" "$n")"
done
if [ -s "$X" ]; then
  parse "$X" "$SGOOD" "$SBAD"
  while read -r h n; do
    row "$n" "$h"
  done < "$SGOOD"
fi

cleanup
# a pull that did not put the scripts in place is a failed pull: the exit code is the only thing
# a script or a CI step can test. Verifying (no source) only reports.
if [ "$pulled_any" -eq 1 ] && [ "$fail" -ne 0 ]; then
  exit 1
fi
exit 0
